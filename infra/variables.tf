variable "config_file" {
  description = "Shared system configuration, relative to the infra working directory."
  type        = string
  default     = "../config.yml"
  validation {
    condition     = can(yamldecode(file(var.config_file)).services)
    error_message = "Provide a readable YAML configuration with a services map."
  }
}
variable "bootstrap_key" {
  description = "Temporary SSH public key generated by scripts/bootstrap.sh."
  type        = string
  validation {
    condition     = can(regex("^ssh-ed25519 ", var.bootstrap_key))
    error_message = "Run OpenTofu through scripts/tofu.sh to generate the bootstrap public key."
  }
}
